# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend URL (For CORS validation)
# Development: http://localhost:3000
# Production: https://YOUR_VERCEL_DOMAIN.vercel.app
FRONTEND_URL=

# MongoDB Database URL (Requires MongoDB Atlas)
DATABASE_URL=

# JWT Secrets (Generate secure random hashes)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Admin Configuration (Required for Magic Link Verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
