# Server Configuration
NODE_ENV=development
PORT=5000

# Frontend URL (For CORS validation)
# Development: http://localhost:3000
# Production: https://tubexproject-frontend.vercel.app
FRONTEND_URL=

# MongoDB Database URL (Requires MongoDB Atlas)
DATABASE_URL=

# JWT Secrets (Generate secure random hashes)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Configuration (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Development Testing
TEST_EMAIL_TO=
